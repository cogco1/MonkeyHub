{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cogco1/MonkeyHub/tree/main/labs/strategy_allocation/state_schema.json",
  "title": "GH-268 StateSnapshot (V0)",
  "description": "One exact, immutable state that every strategy arm forks from. contextPack has the top-level shape of MonkeyHub's ContextPack@1. digest is the lowercase SHA-256 of the canonical JSON of every other field: keys sorted, separators ',' and ':' without spaces, non-ASCII escaped as \\uXXXX, no NaN or infinity. The files in fixtures/ are instances.",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshotId", "caseId", "caseVersion", "environmentVersion", "title", "task", "state", "allowedActions", "contextPack", "sourceRefs", "digest"],
  "properties": {
    "snapshotId": {
      "type": "string",
      "description": "<caseId>@<caseVersion>/<first 12 hex characters of the state digest>",
      "pattern": "^[a-z0-9-]+@v[0-9]+/[0-9a-f]{12}$"
    },
    "caseId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "caseVersion": {"type": "string", "pattern": "^v[0-9]+$"},
    "environmentVersion": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "state": {
      "type": "object",
      "description": "The whole environment state. Every variable is visible; nothing hidden is stored here.",
      "minProperties": 1,
      "additionalProperties": {"type": ["string", "boolean"]}
    },
    "allowedActions": {
      "type": "array",
      "description": "The fixed V0 action set of the case, legal or not in this state.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "asksHuman"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9]+$"},
          "description": {"type": "string", "minLength": 1},
          "asksHuman": {"type": "boolean", "description": "Executing it interrupts a person; counted as a resource, not an outcome."}
        }
      }
    },
    "contextPack": {"$ref": "#/$defs/contextPack"},
    "sourceRefs": {
      "type": "array",
      "description": "Exact identities of every source the case can read: <scheme>://<location>#sha256=<content digest>.",
      "items": {"type": "string", "pattern": "^[a-z]+://.+#sha256=[0-9a-f]{64}$"}
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "contextPack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contextPack", "source", "target", "keep", "request", "contextTier", "escalation", "context", "preflight", "confirmedStage", "scopedDecisions", "studyEvidence", "honesty"],
      "properties": {
        "contextPack": {"const": "ContextPack@1"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectId", "runId", "stateDigest", "exactSource", "actionable", "sourceStageRef", "readWith", "writeWith"],
          "properties": {
            "projectId": {"type": "string"},
            "runId": {"type": "string"},
            "stateDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the canonical JSON of {caseId, state}."},
            "exactSource": {"const": true},
            "actionable": {"type": "boolean"},
            "sourceStageRef": {"type": ["string", "null"]},
            "readWith": {"type": "string"},
            "writeWith": {"type": "string"}
          }
        },
        "target": {"type": ["object", "null"]},
        "keep": {"type": ["object", "null"]},
        "request": {"type": ["object", "null"]},
        "contextTier": {"enum": ["scalar", "component", "design"]},
        "escalation": {"type": "array", "items": {"type": "string"}},
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task", "facts"],
          "properties": {
            "task": {"type": "string", "minLength": 1},
            "facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}}
          }
        },
        "preflight": {"type": ["object", "null"]},
        "confirmedStage": {"type": ["object", "null"]},
        "scopedDecisions": {"type": "array"},
        "studyEvidence": {"type": "array"},
        "honesty": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
