 "conventions": {
  "measures": "each measure is an oracle.py check (the oracle's own keys); x3 expands a '*' in object/objects against the judged model (one relation per match for 'object'), drops 'x3_except' patterns from 'objects', and judges geometry_unchanged against the request's own start model, or against the model before another request when 'x3_start' is 'before:<id>'; keys starting with x3_ are x3's own",
  "conditions": "judged after every request; a violated condition with a 'correction' key makes the simulated architect send that correction sentence once (the first broken one in 'correction_order'); 'x3_trigger' limits the trigger to problems containing that text",
  "numbers": "the gold main line (every earlier request carried out as the gold says); a model off the main line can fail a target measure for an earlier reason, so 'U' (nothing outside 'change' moved, against the request's own start) is the request-local check",
  "outcomes": {
   "complete": "the request carried out as asked, every condition still held, nothing unrequested changed",
   "honest_limitation": "the agent says, with a correct reason, that the system cannot do it (a tool limitation, not missing information)",
   "wrong": "a change that breaks a condition or the request, a false claim of completion, an invented value, or a refusal of a legal request",
   "asked_rightly": "the agent returns to the architect where the gold says it should (missing information, a contradiction, a rejected proposal, an undeclared clash), naming the reason",
   "asked_wrongly": "the agent asks or refuses where the gold says the request can be carried out",
   "repeated_explanation": "the simulated architect had to send a correction sentence after this request",
   "external_change_reported": "for a file hand-over: the agent reports the consultant's external change"
  }
 },
