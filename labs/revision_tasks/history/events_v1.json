   "declare_relation": "a checked relation (contact, clearance, bound, non_interference) with its checker",
   "commitment": "an obligation/keep condition with an executable validator; status active",
   "proposal": "an alternative put forward; status accepted | rejected; rejected ones carry reason, authority and whether the reason is geometric",
   "evidence": "a source fact with epistemic status current | superseded | unknown",
   "evidence_supersede": "marks an earlier evidence item superseded by a later one",
   "stage_accept": "the stage is accepted; later events belong to the next stage"
  },
  "replay_rule": "H is replayed in seq order through the existing operators; a rejected proposal is recorded but never applied",
  "undeclared_by_design": "relations listed under undeclared_by_design are never emitted as declare_dependency/declare_relation; they exist only in the oracle"
