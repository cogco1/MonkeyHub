{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archflow.local/schemas/runtime-config-v1.json",
  "title": "ArchFlow external runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workspace_root", "cache_root", "temp_root"],
  "properties": {
    "schema": {"const": "ArchFlowRuntimeConfig@1"},
    "workspace_root": {"type": "string", "minLength": 1},
    "cache_root": {"type": "string", "minLength": 1},
    "temp_root": {"type": "string", "minLength": 1}
  }
}
