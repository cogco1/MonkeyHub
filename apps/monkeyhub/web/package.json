{
  "name": "monkeyhub-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run sync && vite",
    "build": "npm run sync && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts && node --test --test-concurrency=1 workspaces/test/*.test.ts",
    "sync": "node workspaces/scripts/sync-rhino3dm.mjs",
    "test:workspace": "node --test --test-concurrency=1 workspaces/test/*.test.ts",
    "api:dump": "python workspaces/scripts/dump-openapi.py",
    "api:generate": "node workspaces/scripts/check-generated.mjs --write",
    "api:check": "node workspaces/scripts/check-generated.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@excalidraw/excalidraw": "0.18.1",
    "pdfjs-dist": "6.3.289",
    "rhino3dm": "8.32.2",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "@types/three": "0.185.4"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.18",
      "@radix-ui/react-tabs": "1.1.13"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1"
  }
}
