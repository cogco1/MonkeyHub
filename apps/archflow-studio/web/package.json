{
  "name": "archflow-studio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:rhino3dm": "node scripts/sync-rhino3dm.mjs",
    "sync": "npm run sync:rhino3dm",
    "dev": "npm run sync && vite",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run sync && tsc --noEmit && vite build",
    "api:dump": "python scripts/dump-openapi.py",
    "api:generate": "npm run api:dump && npm --prefix tools/openapi-ts exec -- openapi-ts -i .generated/openapi.json -o src/api/generated",
    "api:check": "node scripts/check-generated.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rhino3dm": "8.32.2",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.18",
      "@radix-ui/react-tabs": "1.1.13"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1"
  }
}
