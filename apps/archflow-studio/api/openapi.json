          },
          "schema": {
            "default": "StudioHealth@3",
            "title": "Schema",
            "type": "string"
          },
          "service": {
            "default": "archflow-studio-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "projectBound"
        ],
        "title": "StudioHealth",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ArchFlow Studio API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Answer without touching the project: binding is not this route's job.",
