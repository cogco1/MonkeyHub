                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudioErrorDto"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Report service posture and whether a project is bound",
        "tags": [
          "health"
        ]
      }
    }
  }
