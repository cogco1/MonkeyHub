                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Acceptedforms"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "schema": {
            "default": "StudioError@1",
            "title": "Schema",
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "title": "StudioErrorDto",
        "type": "object"
      },
      "StudioHealth": {
        "description": "The health answer, in wire names.",
        "properties": {
          "canonicalWriteAuthority": {
            "default": false,
            "title": "Canonicalwriteauthority",
            "type": "boolean"
          },
          "projectBound": {
            "title": "Projectbound",
