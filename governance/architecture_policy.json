{
  "schema": "ArchFlowArchitecturePolicy@1",
  "source_root": "archflow",
  "checked_source_roots": [
    "archflow",
    "tools",
    "apps/archflow-studio/backend"
  ],
  "probe_root": "probes",
  "forbidden_instance_literals": [
    "16x12",
    "community library",
    "live_library",
    "pantheon",
    "parthenon",
    "p087",
    "pentelic",
    "reading room",
    "repair workshop",
    "service desk",
    "slab_on_grade",
    "smooth_stone",
    "test_library"
  ],
  "forbidden_framework_identifiers": [
    "DEFAULT_EXPERT_ORDER",
    "DEFAULT_ROOM_LIST",
    "FIXED_EXPERT_ORDER",
    "FIXED_FOOTPRINT",
    "HARDCODED_TOPOLOGY"
  ],
  "probe_executable_suffixes": [
    ".bat",
    ".cmd",
    ".js",
    ".ps1",
    ".py",
    ".sh",
    ".ts"
  ],
  "allowed_write_sites": [
    {
      "path": "archflow/project/repository.py",
      "function": "*",
      "operations": [
        "mkdir",
        "open_write",
        "replace",
        "unlink"
      ],
      "kind": "project_repository",
      "owner": "P036",
      "reason": "The durable project repository is the sole project-document filesystem writer."
    },
    {
      "path": "archflow/project/runtime.py",
      "function": "initialize_runtime",
      "operations": [
        "mkdir"
      ],
      "kind": "external_runtime_root",
      "owner": "P052",
      "reason": "Creates only explicitly configured external workspace, cache, and temp roots; project documents still flow through P036."
    },
    {
      "path": "archflow/workspace/manager.py",
      "function": "__init__",
      "operations": [
        "mkdir"
      ],
      "kind": "speculative_workspace",
      "owner": "P001",
      "reason": "Creates only the explicitly supplied speculative workspace root."
    },
    {
      "path": "archflow/workspace/manager.py",
      "function": "fork",
      "operations": [
        "mkdir"
      ],
      "kind": "speculative_workspace",
      "owner": "P001",
      "reason": "Creates one branch-local directory under the supplied workspace root."
    },
    {
      "path": "archflow/adapters/fake_voxel.py",
      "function": "build",
      "operations": [
        "write_bytes"
      ],
      "kind": "adapter_workspace",
      "owner": "P001",
      "reason": "Writes a synthetic candidate only inside the supplied speculative workspace."
    },
    {
      "path": "archflow/adapters/cad_execution.py",
      "function": "prepare_rhino_three_dm_export",
      "operations": [
        "open_write"
      ],
      "kind": "adapter_workspace",
      "owner": "M078",
      "reason": "Exclusively creates a deterministic Rhino script inside the explicitly supplied non-symlink speculative workspace; saved 3DM output remains non-canonical."
    },
    {
      "path": "archflow/adapters/minecraft_mcp.py",
      "function": "_write_artifact",
      "operations": [
        "write_bytes"
      ],
      "kind": "adapter_workspace",
      "owner": "P002",
      "reason": "Writes an MCP candidate artifact into the explicit adapter workspace."
    },
    {
      "path": "archflow/adapters/minecraft_mcp.py",
      "function": "_fail",
      "operations": [
        "write_bytes"
      ],
      "kind": "adapter_workspace",
      "owner": "P002",
      "reason": "Writes a bounded failure receipt into the explicit adapter workspace."
    },
    {
      "path": "archflow/adapters/minecraft_mcp.py",
      "function": "_extract_png",
      "operations": [
        "write_bytes"
      ],
      "kind": "adapter_workspace",
      "owner": "P002",
      "reason": "Writes returned visual evidence into the explicit adapter workspace."
    },
    {
      "path": "archflow/runtime/environment_feedback.py",
      "function": "_write_json",
      "operations": [
        "mkdir",
        "write_text"
      ],
      "kind": "legacy_explicit_destination",
      "owner": "M003",
      "reason": "Existing explicit-path environment receipt helper pending durable world-reconciliation routing."
    },
    {
      "path": "archflow/runtime/environment_feedback.py",
      "function": "write_tool_invocation_intent",
      "operations": [
        "helper:_write_json"
      ],
      "kind": "legacy_explicit_destination",
      "owner": "M003",
      "reason": "Existing bounded invocation receipt call site."
    },
    {
      "path": "archflow/runtime/environment_feedback.py",
      "function": "write_tool_environment_observation",
      "operations": [
        "helper:_write_json"
      ],
      "kind": "legacy_explicit_destination",
      "owner": "M003",
      "reason": "Existing bounded environment observation call site."
    },
    {
      "path": "archflow/runtime/environment_feedback.py",
      "function": "write_tool_failure_link",
      "operations": [
        "helper:_write_json"
      ],
      "kind": "legacy_explicit_destination",
      "owner": "M003",
      "reason": "Existing bounded failure-link call site."
    },
    {
      "path": "archflow/runtime/environment_feedback.py",
      "function": "write_environment_feedback_trace",
      "operations": [
        "helper:_write_json"
      ],
      "kind": "legacy_explicit_destination",
      "owner": "M003",
      "reason": "Existing bounded feedback-trace call site."
    }
  ],
  "forbidden_layer_imports": [
    {
      "source": "archflow",
      "targets": [
        "docs",
        "tests",
        "tools"
      ],
      "reason": "Reusable framework code cannot import repository tooling, tests, or documentation modules. Probe imports are rejected by the dedicated probe reverse-import rule."
    },
    {
      "source": "tools",
      "targets": [
        "tests"
      ],
      "reason": "Repository tools cannot acquire implementation or fixtures from the test suite."
    },
    {
      "source": "archflow/contracts",
      "targets": [
        "archflow.adapters",
        "archflow.capabilities",
        "archflow.compilers",
        "archflow.control",
        "archflow.evidence",
        "archflow.materials",
        "archflow.research",
        "archflow.runtime",
        "archflow.validation"
      ],
      "reason": "Canonical contract primitives may depend on project identity only, never on higher domain, control, runtime, or adapter layers."
    },
    {
      "source": "archflow/ports",
      "targets": [
        "archflow.adapters",
        "archflow.capabilities",
        "archflow.compilers",
        "archflow.control",
        "archflow.runtime",
        "archflow.validation"
      ],
      "reason": "External-world protocols may depend on stable identity contracts, never on their concrete adapters, orchestration, control, or validation implementations."
    },
    {
      "source": "archflow/evidence",
      "targets": [
        "archflow.adapters",
        "archflow.capabilities",
        "archflow.compilers",
        "archflow.control",
        "archflow.materials",
        "archflow.research",
        "archflow.runtime",
        "archflow.validation"
      ],
      "reason": "Evidence records cannot acquire retrieval implementation, validation, orchestration, or stage-control authority."
    },
    {
      "source": "archflow/research",
      "targets": [
        "archflow.adapters",
        "archflow.capabilities",
        "archflow.compilers",
        "archflow.control",
        "archflow.materials",
        "archflow.runtime",
        "archflow.validation"
      ],
      "reason": "Research selection and indexing cannot depend on runtime orchestration, concrete adapters, validation, or control."
    },
    {
      "source": "archflow/materials",
      "targets": [
        "archflow.adapters",
        "archflow.capabilities",
        "archflow.compilers",
        "archflow.control",
        "archflow.research",
        "archflow.runtime"
      ],
      "reason": "Material intent and binding validation cannot depend on project runners, orchestration, or concrete adapters."
    },
    {
      "source": "archflow/control",
      "targets": [
        "archflow.adapters",
        "archflow.runtime"
      ],
      "reason": "The control plane consumes typed receipts but cannot depend on concrete adapters or runtime orchestration."
    },
    {
      "source": "archflow/evaluation",
      "targets": [
        "archflow.commit",
        "archflow.project.repository",
        "archflow.validation"
      ],
      "reason": "A read-only evaluator cannot acquire commit repository or hard-gate authority."
    },
    {
      "source": "archflow/validation",
      "targets": [
        "archflow.commit",
        "archflow.evaluation"
      ],
      "reason": "Hard validation cannot commit or depend on soft evaluation."
    },
    {
      "source": "archflow/capabilities",
      "targets": [
        "archflow.commit",
        "archflow.project.repository"
      ],
      "reason": "Detached experts and capabilities cannot acquire persistence or promotion authority."
    },
    {
      "source": "apps/archflow-studio/backend",
      "targets": [
        "rhino3dm",
        "numpy",
        "networkx",
        "OCP",
        "build123d",
        "shapely",
        "trimesh",
        "scipy",
        "tests",
        "tools",
        "probes"
      ],
      "reason": "The Studio backend orchestrates and delegates: geometry mathematics, dependency graphs, and state schemas live in archflow and are imported, never reimplemented beside it (P108 fence)."
    }
  ],
  "authority_symbol_patterns": [
    "^Committer$",
    ".*StateStore$",
    ".*Canonical.*(?:Writer|Store|Repository)$",
    ".*Event.*(?:Writer|Store|Repository|Log)$",
    ".*Checkpoint.*(?:Writer|Store|Repository)$",
    ".*ProjectRepository$"
  ],
  "allowed_authority_symbols": [
    {
      "path": "archflow/commit/committer.py",
      "symbol": "Committer",
      "owner": "P001"
    },
    {
      "path": "archflow/commit/store.py",
      "symbol": "InMemoryStateStore",
      "owner": "P001"
    },
    {
      "path": "archflow/project/ports.py",
      "symbol": "CanonicalRepository",
      "owner": "P035"
    },
    {
      "path": "archflow/project/repository.py",
      "symbol": "FilesystemProjectRepository",
      "owner": "P036"
    },
    {
      "path": "archflow/runtime/event_log.py",
      "symbol": "EventRecordStore",
      "owner": "P018"
    },
    {
      "path": "archflow/runtime/event_log.py",
      "symbol": "AppendOnlyEventLog",
      "owner": "P018"
    }
  ],
  "forbidden_commit_symbols": [
    "aesthetic_winner",
    "ranking",
    "score",
    "unique_winner",
    "winner"
  ]
}
