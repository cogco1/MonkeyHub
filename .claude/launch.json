{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio-api-smoke",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.12",
        "-c",
        "import sys; sys.path.insert(0, 'apps/archflow-studio/api'); from archflow_studio_api.main import main; main()"
      ],
      "port": 8000
    },
    {
      "name": "studio-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/archflow-studio/web",
        "run",
        "dev"
      ],
      "port": 5174
    },
    {
      "name": "archflow-studio",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "apps/archflow-studio/launch-studio.ps1",
        "-NoBrowser"
      ],
      "port": 5174
    },
    {
      "name": "studio-api-villa",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.12",
        "-c",
        "import sys; sys.path.insert(0, 'apps/archflow-studio/api'); from archflow_studio_api.main import main; main(['--port', '8014'])"
      ],
      "port": 8014
    },
    {
      "name": "studio-web-villa",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set ARCHFLOW_STUDIO_API_URL=http://127.0.0.1:8014&& npm --prefix apps/archflow-studio/web run dev -- --port 5184 --strictPort"
      ],
      "port": 5184
    }
  ]
}
