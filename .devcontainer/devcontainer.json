{
  "name": "ArchFlow V4",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "containerEnv": {
    "PYTHONUTF8": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -e . && python tools/archcheck.py",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.unittestEnabled": true,
        "python.testing.unittestArgs": [
          "-v",
          "-s",
          "tests"
        ]
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
